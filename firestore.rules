rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function hasRole(roles) {
      return isAuth() && getUserDoc().rol in roles;
    }

    function isAdminOrSupervisor() {
      return hasRole(['admin', 'supervisor']);
    }

    function isActiveUser() {
      // Missing `activo` counts as active (aligned with Flutter UserModel).
      return isAuth()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && getUserDoc().activo != false;
    }

    function getUserSections() {
      return getUserDoc().secciones;
    }

    // ── Usuarios ─────────────────────────────────────────────
    // Lectura: cualquier usuario autenticado (perfil operativo).
    // Alta / baja / privilegios: solo admin o supervisor.
    // Auto-edición: solo campos de perfil no privilegiados (no rol, activo, secciones, canal).
    match /usuarios/{userId} {
      allow read: if isAuth();

      allow create: if isAdminOrSupervisor();

      allow delete: if isAdminOrSupervisor();

      allow update: if isAdminOrSupervisor()
        || (
          isAuth()
          && request.auth.uid == userId
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.activo == resource.data.activo
          && request.resource.data.secciones == resource.data.secciones
          && request.resource.data.canal == resource.data.canal
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nombre', 'telefono', 'email', 'zona', 'region'])
        );

      // Plantillas WhatsApp personales: solo el dueño.
      match /whatsapp_plantillas/{plantillaId} {
        allow read: if isActiveUser() && request.auth.uid == userId;
        allow delete: if isActiveUser() && request.auth.uid == userId;
        allow create, update: if isActiveUser()
          && request.auth.uid == userId
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 0
          && request.resource.data.nombre.size() <= 80
          && request.resource.data.cuerpo is string
          && request.resource.data.cuerpo.size() > 0
          && request.resource.data.cuerpo.size() <= 2000;
      }
    }

    // ── Jobs de carga de cartera (Excel web) ─────────────────
    // El cliente solo crea el doc inicial; parse/publish los escribe Admin SDK.
    match /trabajos_cartera/{jobId} {
      allow read: if isAdminOrSupervisor();
      allow create: if isAdminOrSupervisor()
        && request.resource.data.creado_por_uid == request.auth.uid
        && request.resource.data.estado == 'subiendo'
        && request.resource.data.campaign_id is string;
      allow update, delete: if false;
    }

    // ── Campañas ─────────────────────────────────────────────
    // Campaign root docs: admin writes, all active auth reads
    match /{campaignCollection}/{campaignId} {
      allow read: if isActiveUser() && campaignCollection == 'campañas';
      allow write: if isAdminOrSupervisor() && campaignCollection == 'campañas';

      // Gestores sub-collection (section-level docs)
      match /gestores/{seccionId} {
        allow read: if isActiveUser() && campaignCollection == 'campañas';
        allow write: if isAdminOrSupervisor() && campaignCollection == 'campañas';

        // Clientes sub-collection
        // Gestors can only update clients in THEIR assigned section.
        // Admin/supervisor can write anything.
        match /clientes/{clienteId} {
          allow read: if isActiveUser() && campaignCollection == 'campañas';
          allow create: if isAdminOrSupervisor() && campaignCollection == 'campañas';
          allow update: if campaignCollection == 'campañas' && isActiveUser() && (
            isAdminOrSupervisor()
            || (
              seccionId in getUserSections()
              && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['seccion', 'seccion_key', 'region', 'zona'])
            )
          );
          allow delete: if isAdminOrSupervisor() && campaignCollection == 'campañas';

          // Historial de cambios de contacto para trazabilidad completa.
          match /historial_contacto/{histId} {
            allow read: if isActiveUser() && campaignCollection == 'campañas';
            allow create: if campaignCollection == 'campañas' && isActiveUser() && (
              isAdminOrSupervisor()
              || (seccionId in getUserSections())
            );
            allow update: if campaignCollection == 'campañas' && isActiveUser() && (
              isAdminOrSupervisor()
              || (
                seccionId in getUserSections()
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'nivel_confianza', 'orden', 'oculto', 'es_principal',
                  'nota', 'fecha', 'fecha_evento'
                ])
              )
            );
            allow delete: if isAdminOrSupervisor() && campaignCollection == 'campañas';
          }

          // Historial append-only de visitas / gestiones de cobranza.
          match /historial_visitas/{visitaId} {
            allow read: if isActiveUser() && campaignCollection == 'campañas';
            allow create: if campaignCollection == 'campañas' && isActiveUser() && (
              isAdminOrSupervisor()
              || (seccionId in getUserSections())
            );
            allow update: if false;
            allow delete: if isAdminOrSupervisor() && campaignCollection == 'campañas';
          }

          // Descargos del cliente: lo que respondió la persona contactada
          // + evidencias (foto/audio en Storage). Append-only para auditoría.
          match /descargos/{descargoId} {
            allow read: if isActiveUser() && campaignCollection == 'campañas';
            allow create: if campaignCollection == 'campañas' && isActiveUser() && (
              isAdminOrSupervisor()
              || (seccionId in getUserSections())
            );
            allow update: if false;
            allow delete: if isAdminOrSupervisor() && campaignCollection == 'campañas';
          }
        }
      }
    }

    // ── Alertas ──────────────────────────────────────────────
    // Any active authenticated user can create alerts.
    // Admin/supervisor/asistente can read alerts.
    // Only admin/supervisor can update (mark as reviewed).
    match /alertas/{alertId} {
      allow create: if isActiveUser();
      allow read: if isActiveUser() && hasRole(['admin', 'supervisor', 'asistente']);
      allow update: if isAdminOrSupervisor();
      allow delete: if isAdminOrSupervisor();
    }

    // ── Casos de problema (embudo resolutor) ─────────────────
    // Gestores abren casos; resolutor/admin/supervisor gestionan el embudo.
    function canManageCasos() {
      return isActiveUser() && hasRole(['resolutor', 'admin', 'supervisor']);
    }

    match /casos/{casoId} {
      allow create: if isActiveUser()
        && request.resource.data.tipo is string
        && request.resource.data.etapa is string
        && request.resource.data.abierto is bool;
      allow read: if canManageCasos();
      // Resolutor gestiona el embudo; gestores pueden reabrir/remarcar.
      allow update: if canManageCasos()
        || (
          isActiveUser()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'etapa', 'abierto', 'fecha_etapa', 'fecha_apertura',
              'nota_origen', 'gps_latitud', 'gps_longitud',
              'gestor_uid', 'gestor_nombre', 'gestor_email',
              'actualizado_por_uid', 'actualizado_por_nombre'
            ])
        );
      allow delete: if isAdminOrSupervisor();

      match /comentarios/{comentarioId} {
        allow read: if canManageCasos();
        allow create: if canManageCasos()
          && request.resource.data.texto is string
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }

      match /movimientos/{movimientoId} {
        allow read: if canManageCasos();
        allow create: if canManageCasos()
          || (
            isActiveUser()
            && request.resource.data.de is string
            && request.resource.data.a is string
          );
        allow update, delete: if false;
      }
    }

    // ── Notificaciones (Base Updates → Gestores) ─────────────
    // Admin creates notifications; gestores read their own and mark as read.
    match /notificaciones/{notifId} {
      allow create: if isAdminOrSupervisor();
      allow read: if isActiveUser() && (
        isAdminOrSupervisor()
        || resource.data.destinatario_uid == request.auth.uid
      );
      allow update: if isActiveUser() && (
        // Gestores can only mark as read
        (resource.data.destinatario_uid == request.auth.uid
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida'])
         && request.resource.data.leida == true)
        || isAdminOrSupervisor()
      );
    }

    // ── Cartas Generadas (JPG para gestores) ────────────────────
    // Admin/supervisor publica metadatos de cartas.
    // Gestores leen solo cartas asignadas por uid o por secciones.
    match /cartas_generadas/{cartaId} {
      allow create, update: if isActiveUser() && (
        isAdminOrSupervisor()
        || (
          request.resource.data.gestor_uid == request.auth.uid
          && request.resource.data.source_mode == 'client_fallback'
          && request.resource.data.mime_type.matches('image/.*')
        )
      );
      allow delete: if isAdminOrSupervisor();
      allow read: if isActiveUser() && (
        isAdminOrSupervisor()
        || resource.data.gestor_uid == request.auth.uid
        || (
          resource.data.seccion_key is string
          && resource.data.seccion_key in getUserSections()
        )
      );
    }

    // ── Ubicaciones de Gestores (GPS Tracking) ───────────────
    // Gestors write their own location points.
    // Admin/supervisor can read all tracking data.
    match /ubicaciones_gestores/{odId} {
      allow read: if isAdminOrSupervisor();
      allow write: if isActiveUser() && request.auth.uid == odId;

      match /puntos/{puntoId} {
        allow read: if isAdminOrSupervisor();
        allow create: if isActiveUser() && request.auth.uid == odId;
      }
    }

    // ── Estructura Territorial (Catálogo Región→Zona→Sección) ─
    // All active users can read the catalog.
    // Only admin/supervisor can write (generated from Excel upload).
    match /estructura_territorial/{docId} {
      allow read: if isActiveUser();
      allow write: if isAdminOrSupervisor();
    }

    // ── Configuración (Catálogos, Niveles, Parámetros) ──────
    // All active users can read configuration.
    // Only admin/supervisor can write.
    match /configuracion/{docId} {
      allow read: if isActiveUser();
      allow write: if isAdminOrSupervisor();
    }

    // ── Doxeo (consultas Telegram vía worker PC) ─────────────
    // El APK encola trabajos; un worker twi con Admin SDK (bypasea rules)
    // los reclama, ejecuta contra Telegram y escribe el resultado.
    // Comandos y heartbeats los escribe solo el worker (Admin SDK).
    match /doxeo_comandos/{comandoId} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    match /doxeo_workers/{workerId} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    match /doxeo_lock/{docId} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    match /doxeo_jobs/{jobId} {
      allow read: if isActiveUser() && (
        isAdminOrSupervisor()
        || resource.data.solicitante.uid == request.auth.uid
        || (
          resource.data.cliente.seccion_key is string
          && resource.data.cliente.seccion_key in getUserSections()
        )
      );
      allow create: if isActiveUser()
        && request.resource.data.keys().hasAll([
          'dni', 'comando_id', 'comando_nombre', 'mensaje',
          'cliente', 'solicitante', 'estado', 'creado_at'
        ])
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.solicitante.uid == request.auth.uid;
      // El gestor solo puede cancelar su propio trabajo mientras siga pendiente.
      allow update: if isActiveUser()
        && resource.data.solicitante.uid == request.auth.uid
        && resource.data.estado == 'pendiente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && request.resource.data.estado == 'cancelado';
      allow delete: if false;
    }

    // ── Bitácora de campo (índice denormalizado admin/supervisor) ─
    // Gestores/admin crean eventos al guardar GPS, notas o (vía worker) Telegram.
    // Solo admin/supervisor leen. Append-only: sin update/delete desde clientes.
    match /bitacora_campo/{eventId} {
      allow read: if isAdminOrSupervisor();
      allow create: if isActiveUser()
        && request.resource.data.usuario_uid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'tipo', 'creado_at', 'fecha_dia',
          'campaign_id', 'seccion_key',
          'cliente_id', 'cliente_nombre', 'codigo_cliente', 'dni',
          'usuario_uid', 'usuario_nombre', 'usuario_rol',
          'resumen', 'origen_id', 'origen_coleccion', 'payload'
        ])
        && request.resource.data.tipo in [
          'ubicacion', 'telegram', 'nota_campo', 'nota_gestion'
        ];
      allow update, delete: if false;
    }

    // ── Rutas Diarias (Route Planning) ───────────────────────
    // Gestors create/update their own routes (doc ID = date_uid).
    // Admin/supervisor can read all routes.
    match /rutas_diarias/{rutaId} {
      function isOwnRouteById() {
        return rutaId.matches('^.+_' + request.auth.uid + '$');
      }
      allow read: if isActiveUser() && (
        isAdminOrSupervisor()
        || isOwnRouteById()
        || resource.data.gestor_uid == request.auth.uid
      );
      allow create: if isActiveUser() && (
        isAdminOrSupervisor()
        || request.resource.data.gestor_uid == request.auth.uid
      );
      allow update: if isActiveUser() && (
        isAdminOrSupervisor()
        || resource.data.gestor_uid == request.auth.uid
      );
      allow delete: if isActiveUser() && (
        isAdminOrSupervisor()
        || resource.data.gestor_uid == request.auth.uid
      );
    }
  }
}
